# --- Upstash Redis Queue Configuration ---
# Your Upstash Redis connection string (use rediss:// for SSL)
UPSTASH_REDIS_URL=rediss://default:your_upstash_password@your_upstash_host.upstash.io:6379

# --- GitLab Configuration ---
# GitLab instance URL (use https://gitlab.com or your self-hosted URL)
GITLAB_URL=https://gitlab.com
# Personal / Project Access Token with 'api' scope to fetch diffs and post comments
GITLAB_TOKEN=glpat-yourgitlabtokenhere
# Webhook Secret Token to verify incoming webhooks (must match the token in GitLab settings)
WEBHOOK_SECRET=your_secure_webhook_secret_here

# --- Google Gemini API Configuration ---
# Google AI Studio Gemini API Key (No credit card free tier)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# --- Agent Behavior Configuration ---
# Target branches to run reviews for (comma-separated). Webhooks on other target branches will be ignored.
TARGET_BRANCHES=dev,main
# Severity threshold to request changes (e.g., block MR approval if there is a 'CRITICAL' or 'WARNING' issue)
# Options: CRITICAL, WARNING, SUGGESTION, STYLE
BLOCK_ON_SEVERITY=CRITICAL

# --- AI Agent Review Checklist ---
# Provide custom checklist guidelines for the agent. Feel free to update/expand this.
REVIEW_CHECKLIST="1. Check for security vulnerabilities, including SQL injection, XSS, SSRF, and exposure of secrets/credentials.\n2. Ensure endpoints enforce proper authorization and Role-Based Access Control (RBAC).\n3. Check for performance issues, such as N+1 database queries, resource leaks, or missing indexes.\n4. Verify code readability, proper error handling, logging best practices, and formatting.\n5. Check for missing unit tests or regression risks in modified business logic."
